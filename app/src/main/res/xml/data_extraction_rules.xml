<?xml version="1.0" encoding="utf-8"?>
<!-- Reglas de copia y transferencia para Android 12 y superiores. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="com.google.firebase.auth.api.key" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="com.google.firebase.auth.api.key" />
    </device-transfer>
</data-extraction-rules>
