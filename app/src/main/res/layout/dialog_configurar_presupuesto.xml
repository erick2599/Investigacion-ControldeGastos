<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android ="http://schemas.android.com/apk/res/android"
            xmlns:app="http://android.com"


            android:layout_width="match_parent"
            android:layout_height="wrap_content">

<LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configurar Tus Ingresos"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:textColor="@android:color/black"/>

    <!-- Salario -->
    <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Salario"
            app:prefixText="$">
        <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etIngresoSalario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:text="0.0"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Bonos -->
    <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Bonos"
            app:prefixText="$">
        <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etIngresoBonos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:text="0.0"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Remesas -->
    <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Remesas"
            app:prefixText="$">
        <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etIngresoRemesas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:text="0.0"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Otros Ingresos -->
    <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Otros Ingresos"
            app:prefixText="$">
        <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etIngresoOtros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:text="0.0"/>
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

        <Button
                android:id="@+id/btnCancelarPresupuesto"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancelar" />

        <Button
                android:id="@+id/btnGuardarPresupuesto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Calcular"
                app:backgroundTint="@color/verde_primario" />
    </LinearLayout>
</LinearLayout>
</ScrollView>
